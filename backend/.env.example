# ===== 填你自己的密钥，这个文件不要上传到任何地方 =====
# 二选一即可，推荐先用智谱（有免费模型）

# --- 方案A：智谱 BigModel（免费，推荐新手）---
# 注册地址：https://open.bigmodel.cn  ->  API Keys  ->  复制
BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL=glm-4-flash
API_KEY=YOUR_ZHIPU_KEY_HERE

